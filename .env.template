# .env — Variables de entorno para Docker Compose en el VPS
# Copia este archivo como .env en /home/apps/rmrLocationsApi/ del VPS
# NUNCA subas .env al repositorio (ya está en .gitignore)

# Dominio de la API (sin https://)
# Si no tienes dominio, usa localhost (pero no tendrás HTTPS válido)
DOMAIN=rmrlocations.com

# Email para Let's Encrypt (avisos de expiración de certificados)
LETSENCRYPT_EMAIL=tu-email@example.com

# Contraseña de PostgreSQL (¡cámbiala en producción!)
POSTGRES_PASSWORD=ChangeMe123!

# JWT Token (debe coincidir con appsettings.json o sobrescribirlo)
JWT_TOKEN=MySuperSecureAndRandomKeyThatLooksJustAwesomeAndNeedsToBeVeryVeryLong!!!111oneeleven
JWT_ISSUER=rmrLocationsApi
JWT_AUDIENCE=rmrLocationsApi

# Credenciales dashboard Traefik (admin / admin por defecto — ¡CÁMBIALAS!)
# Generar con: htpasswd -nb admin TU_CONTRASEÑA
TRAEFIK_AUTH_USERS=admin:$$apr1$$xT6aHO5r$$9Qhrm.YbFjKEudvgU5aRg0
