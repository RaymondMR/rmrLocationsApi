# .env — Variables de entorno para Docker Compose en el VPS
# Copia este archivo como .env en el directorio del proyecto en el VPS.
# NUNCA subas .env al repositorio (ya está en .gitignore).
#
# Arquitectura: NGINX (host, TLS con Certbot) → Traefik (Docker, loopback) → API

# ---------------------------------------------------------------------------
# DOMINIO
# ---------------------------------------------------------------------------
# Dominio base, sin https:// ni barra final. La API se publica en api.<DOMAIN>.
# Requiere un registro A `api.<DOMAIN>` apuntando a la IP del VPS (92.118.59.247).
# Docker Compose ABORTA si esta variable falta: es intencional, evita desplegar
# una configuración silenciosamente rota.
DOMAIN=rmrlocations.com

# Correo para los avisos de expiración de Let's Encrypt.
# Lo consume el comando `certbot` en el host, no Docker Compose.
# NO uses @example.com: Let's Encrypt rechaza el registro de la cuenta.
LETSENCRYPT_EMAIL=montoyacode@gmail.com

# ---------------------------------------------------------------------------
# SECRETOS — genera valores únicos, NO uses los de ejemplo
# ---------------------------------------------------------------------------
# Contraseña de PostgreSQL.
#   Generar:  openssl rand -base64 32
#
# ⚠️ Si la cambias DESPUÉS de que el volumen postgres-data ya exista, PostgreSQL
# conservará la contraseña con la que se inicializó y la API no podrá conectar.
# En ese caso hay que cambiarla también dentro de la base de datos:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres WITH PASSWORD 'nueva';"
POSTGRES_PASSWORD=

# Clave de firma de los JWT.
#   Generar:  openssl rand -base64 64
#
# ⚠️ CRÍTICO: el valor que había aquí antes está publicado en el repositorio de
# GitHub. Cualquiera que lo conozca puede fabricar tokens de administrador válidos
# contra tu API. Genera uno nuevo y no lo compartas nunca.
# Cambiarlo invalida todas las sesiones activas, lo cual es lo deseable.
JWT_TOKEN=

JWT_ISSUER=rmrLocationsApi
JWT_AUDIENCE=rmrLocationsApi
